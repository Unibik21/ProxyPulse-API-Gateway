generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  admins    Admin[]
  services  Service[]
  users     User[]
}

// Dashboard login accounts — one per person, scoped to an org
model Admin {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
}

// Upstream services proxied by the gateway
model Service {
  id        String       @id @default(uuid())
  name      String
  baseUrl   String
  healthy   Boolean      @default(true)
  createdAt DateTime     @default(now())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routes    Route[]

  @@unique([name, orgId])
}

// Gateway routes — paths must be globally unique (gateway matches on path alone)
model Route {
  id        String   @id @default(uuid())
  path      String   @unique
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rateLimit Int?
  cacheTtl  Int?
  createdAt DateTime @default(now())
}

// API key holders (org members / developers), not dashboard admins
model User {
  id        String       @id @default(uuid())
  email     String
  name      String?
  createdAt DateTime     @default(now())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]

  @@unique([email, orgId])
}

model ApiKey {
  id        String    @id @default(uuid())
  key       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}
